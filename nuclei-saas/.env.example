# =============================================================================
# LegionCyber Shield - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in all required values before running.
# Never commit the .env file to version control.
# Generate SECRET_KEY with: make generate-secret-key
# Generate ENCRYPTION_KEY with: make generate-encryption-key
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Full async PostgreSQL connection string used by SQLAlchemy/asyncpg
DATABASE_URL=postgresql+asyncpg://lcshield:changeme_secure_password@postgres:5432/legioncyber_shield

# Individual Postgres credentials (used by the postgres Docker service)
POSTGRES_DB=legioncyber_shield
POSTGRES_USER=lcshield
POSTGRES_PASSWORD=changeme_secure_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Used for Celery task broker and result backend
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# 256-bit random hex string — run: make generate-secret-key
SECRET_KEY=your-256-bit-secret-key-here-replace-before-production

# Fernet encryption key for storing sensitive credentials at rest
# Run: make generate-encryption-key
ENCRYPTION_KEY=your-fernet-encryption-key-here-replace-before-production

# JWT settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Zoho Books (Billing & Subscriptions)
# -----------------------------------------------------------------------------
# OAuth2 credentials from Zoho API Console: https://api-console.zoho.com/
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Your Zoho Books organization ID (found in Zoho Books → Settings → General)
ZOHO_ORGANIZATION_ID=

# Long-lived refresh token obtained during initial OAuth2 flow
ZOHO_REFRESH_TOKEN=

# Zoho Books Plan item IDs (Zoho subscription plan codes)
ZOHO_PLAN_STARTER_ID=
ZOHO_PLAN_PROFESSIONAL_ID=
ZOHO_PLAN_ENTERPRISE_ID=

# Zoho one-time product ID for single scan purchases
ZOHO_ONETIME_PRODUCT_ID=

# Webhook verification secret configured in Zoho Books webhook settings
ZOHO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public-facing frontend URL (used in emails, CORS allow-list)
FRONTEND_URL=https://shield.legioncyber.com

# Public-facing API URL
API_URL=https://api.shield.legioncyber.com

# Exposed to Next.js browser bundle — must begin with NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=https://api.shield.legioncyber.com

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=https://shield.legioncyber.com,https://api.shield.legioncyber.com

# -----------------------------------------------------------------------------
# AWS S3 (Report & Artifact Storage)
# -----------------------------------------------------------------------------
# IAM user credentials with s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=legioncyber-shield-reports

# Optional: presigned URL expiry in seconds (default 3600 = 1 hour)
S3_PRESIGNED_URL_EXPIRY=3600

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# SMTP server settings for transactional emails (scan complete, alerts, billing)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=shield@legioncyber.com

# Display name shown in From header
FROM_NAME=LegionCyber Shield

# Optional: BCC all outbound email to this address for audit trail
# EMAIL_BCC=audit@legioncyber.com

# -----------------------------------------------------------------------------
# Nuclei Scanner
# -----------------------------------------------------------------------------
# Path to nuclei binary inside scanner container
NUCLEI_BINARY_PATH=/usr/local/bin/nuclei

# Path where official nuclei-templates are stored (Docker volume)
NUCLEI_TEMPLATES_PATH=/opt/nuclei-templates

# Path where custom LegionCyber templates are stored (bind mount)
NUCLEI_CUSTOM_TEMPLATES_PATH=/opt/custom-templates

# Maximum concurrent nuclei templates per scan job
NUCLEI_RATE_LIMIT=150

# Maximum requests per second nuclei will send per scan
NUCLEI_BULK_SIZE=25

# Nuclei scan timeout in seconds
NUCLEI_TIMEOUT=300

# -----------------------------------------------------------------------------
# Integrations (Optional)
# -----------------------------------------------------------------------------

# Vanta compliance automation
VANTA_API_KEY=

# Cloudflare WAF integration (bypass headers / IP allowlisting for scans)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# Akamai WAF integration
AKAMAI_CLIENT_SECRET=
AKAMAI_CLIENT_TOKEN=
AKAMAI_ACCESS_TOKEN=
AKAMAI_HOST=

# Imperva / Incapsula WAF integration
IMPERVA_API_ID=
IMPERVA_API_KEY=

# Slack notifications webhook
SLACK_WEBHOOK_URL=

# PagerDuty integration key (for critical findings alerts)
PAGERDUTY_INTEGRATION_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Set to "true" to enable/disable specific platform features
FEATURE_COMPLIANCE_REPORTS=true
FEATURE_AUTHENTICATED_SCANS=true
FEATURE_API_ACCESS=true
FEATURE_WHITE_LABEL=false
FEATURE_SSO=false

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Python log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to "production" or "development"
APP_ENV=production

# Number of Celery worker processes for scan tasks
CELERY_SCAN_CONCURRENCY=4

# Max scan duration before forceful timeout (seconds)
MAX_SCAN_DURATION_SECONDS=7200

# Report retention in S3 (days, 0 = indefinite)
REPORT_RETENTION_DAYS=365
